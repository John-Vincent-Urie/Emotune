DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-strong-secret-key
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Database. Leave DJANGO_DB_ENGINE unset for SQLite (local venv, tests).
# docker-compose.yml sets DJANGO_DB_ENGINE=mysql and MYSQL_HOST=db for the
# container itself; the MYSQL_* values below are shared by the db service, the
# backend and phpMyAdmin, and are REQUIRED before `docker compose up`.
# Choose your own password (e.g. `openssl rand -base64 24`); it is fixed
# when the MySQL volume is first created.
# DJANGO_DB_ENGINE=mysql
MYSQL_DATABASE=emotune
MYSQL_USER=emotune
MYSQL_PASSWORD=
# From the host venv (tests against MySQL): MYSQL_HOST=127.0.0.1, MYSQL_PORT=3307.
# MYSQL_HOST_PORT=3307
# PHPMYADMIN_PORT=8081
# Both default to DEBUG/off, so a DEBUG=false deployment is locked down unless
# you name the origins that may call the API.
# Left unset on purpose: allow-all then follows DEBUG, so copying this file to a
# deployment does not carry a development convenience into production. Set it to
# true only for local work that needs it.
# DJANGO_CORS_ALLOW_ALL_ORIGINS=
DJANGO_CORS_ALLOWED_ORIGINS=
# DJANGO_CORS_ALLOW_CREDENTIALS=false
DJANGO_CSRF_TRUSTED_ORIGINS=

# Transport hardening. These all default to "on when DEBUG is false", so the
# lines below only matter if a deployment needs to differ.
# DJANGO_TRUST_PROXY_SSL_HEADER=false   # true only behind a proxy that sets X-Forwarded-Proto
# DJANGO_SECURE_SSL_REDIRECT=
# DJANGO_SESSION_COOKIE_SECURE=
# DJANGO_CSRF_COOKIE_SECURE=
# DJANGO_SECURE_HSTS_SECONDS=
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=
# DJANGO_SECURE_HSTS_PRELOAD=false      # one-way door; opt in deliberately

# Access tokens cannot be revoked, so keep them short; the refresh token (which
# can be blacklisted) carries the session. Setting JWT_ACCESS_TOKEN_DAYS instead
# overrides this with the old day-based lifetime.
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=30

# Rate limits on the credential endpoints (see backend/users/throttles.py).
# Leave these unset: the defaults follow DJANGO_DEBUG. With it off you get the
# production rates shown below; with it on, much looser ones, because every dev
# client (browser, emulator, phone over adb reverse, Docker) shares one address
# and the production rates would lock the whole team out. Uncomment to override.
# THROTTLE_LOGIN_IP=20/min
# THROTTLE_LOGIN_EMAIL=10/min
# THROTTLE_REGISTER=10/hour
# THROTTLE_PASSWORD_CHANGE=10/hour
# THROTTLE_PASSWORD_RESET_IP=20/hour
# THROTTLE_PASSWORD_RESET_EMAIL=6/hour
# THROTTLE_PASSWORD_RESET_VERIFY_IP=60/hour
# THROTTLE_PASSWORD_RESET_VERIFY_EMAIL=20/hour

# Reverse proxies in front of Django that append X-Forwarded-For. 0 means none:
# throttles use the connecting address and ignore that header, which a client
# could otherwise fake to dodge them. Set 1 only behind one trusted proxy.
DRF_NUM_PROXIES=0

# Outgoing mail, used to send the forgotten-password code. Leave EMAIL_HOST_USER
# blank and Django prints the mail to the runserver console instead, which is
# enough to develop and test the flow without a real mailbox.
#
# For Gmail this must be an App Password, not your account password: turn on
# 2-Step Verification, then Google Account > Security > App passwords, and paste
# the 16-character value here (spaces optional).
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=EmoTune <you@gmail.com>

SPOTIFY_CLIENT_ID=replace-with-your-spotify-client-id
SPOTIFY_CLIENT_SECRET=replace-with-your-spotify-client-secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/spotify/callback/
SPOTIFY_APP_REMOTE_REDIRECT_URI=emotune://spotify-auth-callback
SPOTIFY_APP_RETURN_URI=emotune://spotify-connected
SPOTIFY_OAUTH_STATE_MAX_AGE_SECONDS=600
SPOTIFY_HTTP_TIMEOUT_SECONDS=8
# Verified, current crisis line for your deployment's region. Appended to the
# safety fallback message shown when a user's text matches self-harm/suicide
# language (backend/api/safety.py). Leave empty rather than guessing -- a wrong
# hotline is worse than none. Example for a Philippines deployment (VERIFY before
# using): "You can also reach the National Center for Mental Health Crisis Hotline
# at 1553, or 0917-899-8727 / 0966-351-4518."
CRISIS_HOTLINE_TEXT=

EMOTION_HIGH_CONFIDENCE_THRESHOLD=0.68
EMOTION_MEDIUM_CONFIDENCE_THRESHOLD=0.45
EMOTION_MIN_MARGIN_THRESHOLD=0.12
EMOTION_TOP_EMOTIONS_COUNT=2
ML_MODEL_PATH=
